# Database — Railway's Postgres plugin injects DATABASE_URL automatically.
# Set DATABASE_URI only to point at a different database.
DATABASE_URI=postgres://user:password@host:5432/dbname

# Required. Signs admin sessions — use a long random string, never reuse the dev value.
PAYLOAD_SECRET=

# Optional: notify the team when a new lead arrives. Unset = notifications skipped,
# the lead is still saved and visible in the admin.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_NOTIFY_TO=
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=

# Optional: where uploaded media is written (default public/media).
MEDIA_DIR=
